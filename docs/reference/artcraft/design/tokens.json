{
  "authority": ["src/styles/Cinematic.css", "src/App.css", "src/features/library/LibraryCatalog.css"],
  "palette": {
    "dark": {"accent": "#55d6ff", "text": "#f4f6f8", "muted": "#a8adb5", "canvas": "#070b10", "success": "#62dc78"},
    "light": {"accent": "#0067c0", "text": "#111827", "muted": "#40536a", "canvas": "var(--surface-canvas)", "success": "#0f6c0f"}
  },
  "catalog": {
    "normal": {"minHeight": 260, "cover": 48, "title": 17, "controlMinHeight": 38},
    "compact": {"minHeight": 230, "cover": 40, "title": 15, "controlMinHeight": 34},
    "spacing": "existing --spacing-xs/sm/md/lg",
    "font": "existing --font-family",
    "surface": "existing --surface-2",
    "primaryAction": "existing --action-primary-background/border/text",
    "focus": "2px solid var(--color-primary)",
    "progress": {"height": "--catalog-progress-height: 4px", "transition": "transform var(--motion-press)", "reducedMotion": "global transition-property excludes transform"},
    "grid": {"below600": 1, "from600": 2, "from1180": 3, "from1600": 4}
  },
  "validation": {
    "static": "node scripts/checks/check-theme-contrast.mjs",
    "rendered": "scripts/ui/check-library-catalog.py: accessibility()",
    "minimumText": 4.5,
    "minimumFocus": 3.0
  }
}
